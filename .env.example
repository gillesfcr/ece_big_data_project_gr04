# Copy this file to .env and fill it in (.env is not committed).
# Contact information sent in the User-Agent of the requests to the Wikimedia
# APIs (required by https://meta.wikimedia.org/wiki/User-Agent_policy).
WIKIMEDIA_CONTACT=your.email@example.com

# Memory of the Spark driver. Default: 60% of the memory available to the
# container, between 2g and 8g. On a machine with 8 GB of RAM use 3g.
# SPARK_DRIVER_MEMORY=3g
# Number of shuffle partitions (default 200; 32 on a low-memory machine).
# SPARK_SHUFFLE_PARTITIONS=32
